# ---------------------------------------------------------------------------
# Servidor nginx para el frontend estático de la Librería + proxy a la API.
#
# Este archivo es una PLANTILLA: la imagen oficial de nginx lo copia a
# /etc/nginx/templates/default.conf.template y, al arrancar el contenedor, el
# entrypoint reemplaza ${API_UPSTREAM} por el valor de la variable de entorno.
#
# API_UPSTREAM tiene la forma host:puerto, SIN http:// y SIN barra final.
# Ejemplo: API_UPSTREAM=libreria-api:8000
#
# La barra final de proxy_pass es obligatoria: hace que /api/libros/ llegue a
# FastAPI como /libros/.
# ---------------------------------------------------------------------------
server {
    listen       80;
    listen       [::]:80;
    server_name  _;

    root  /usr/share/nginx/html;
    index index.html;

    # No expone la versión de nginx en las respuestas ni en las páginas de error.
    server_tokens off;

    # Los archivos fuente están en UTF-8: se declara para tildes y ñ.
    charset utf-8;

    # Sin listados de directorio: si falta un archivo se responde 404.
    autoindex off;

    # ------------------------------- Compresión -------------------------------
    gzip              on;
    gzip_vary         on;
    gzip_comp_level   5;
    gzip_min_length   256;
    gzip_proxied      any;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        image/svg+xml;

    # --------------------------------- Caché ----------------------------------
    # Sitio chico que se redespliega seguido y se revisa durante el parcial:
    # se prefiere contenido siempre fresco (no-cache = revalida, no prohíbe cachear).
    add_header Cache-Control "no-cache" always;

    # --------------------------- Cabeceras de seguridad -----------------------
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options        "SAMEORIGIN" always;
    add_header Referrer-Policy        "no-referrer" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;

    # --------------------------------- Rutas ----------------------------------
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy a la API. El front siempre llama a /api/... (same-origin), así no
    # hacen falta CORS ni una URL absoluta en el JavaScript.
    location /api/ {
        proxy_pass http://${API_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout    60s;
    }

    # Bloquea archivos ocultos (.git, .env, etc.) salvo los desafíos ACME.
    location ~ /\.(?!well-known) {
        deny all;
    }
}
