# Normaliza finales de línea: los archivos de infraestructura viajan con LF.
# Un Dockerfile o docker-compose.yml con CRLF puede romper el parseo (las
# continuaciones con \ quedan escapadas de forma distinta) y ensucia los diffs.
* text=auto

*.sh    text eol=lf
*.conf  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.md    text eol=lf

Dockerfile      text eol=lf
.dockerignore   text eol=lf
